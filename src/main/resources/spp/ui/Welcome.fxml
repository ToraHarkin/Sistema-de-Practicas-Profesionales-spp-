<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" styleClass="" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.ui.controller.WelcomeController">
    <stylesheets>
        <URL value="@css/welcome.css" />
    </stylesheets>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="main-container" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="8.0" styleClass="header-section">
               <children>
                  <Label styleClass="univer-label" text="Universidad Veracruzana" />
                  <Label styleClass="title-label" text="Sistema de Gestión de Prácticas Profesionales" />
                  <Label styleClass="subtitle-label" text="Bienvenido. Para comenzar, primero vamos a configurar el sistema." />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="12.0" styleClass="center-section">
               <children>
                  <Button maxWidth="320.0" mnemonicParsing="false" onAction="#handleStartSetUp" styleClass="initial-config-button" text="Iniciar configuración" />
                  <Label maxWidth="320.0" styleClass="description-label" text="La configuración del sistema debe ser inicializada por personal autorizado de la Universidad Veracruzana." textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="footer-section" VBox.vgrow="ALWAYS">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="480.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/lis-y-luzio.png" />
                     </image>
                  </ImageView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
